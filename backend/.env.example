# ==============================================================================
# LearnMate AI - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Settings
PROJECT_NAME="LearnMate AI API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# For Neon pooled connection (app runtime):
# postgresql+asyncpg://<username>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?ssl=require
DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/learnmate"

# For Neon direct compute connection (migrations / admin):
DIRECT_DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/learnmate"

# Isolated test database (must be separate from application databases):
TEST_DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/learnmate_test"
DATABASE_ECHO=False

# Security & JWT
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"
JWT_ISSUER="learnmate-ai"
JWT_AUDIENCE="learnmate-ai-users"

# CORS Configuration (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ChromaDB Persistence
CHROMA_PERSIST_DIRECTORY="./chroma_data"

# Optional LLM Provider Keys (All optional at boot)
GEMINI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
