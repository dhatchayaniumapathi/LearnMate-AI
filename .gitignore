# ==============================================================================
# LearnMate AI - Git Ignore Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets.json
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / Packaging
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
develop-eggs/
downloads/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec

# Testing, Coverage & Linters
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter Notebooks
.ipynb_checkpoints

# Celery / Task queues
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# Node.js & Frontend (React + Vite)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production & Build outputs
dist/
dist-ssr/
out/
build/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/

# Local cache & temporary files
.turbo/
.eslintcache
.stylelintcache
.vite/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ------------------------------------------------------------------------------
# Databases, Vector Stores & Uploads
# ------------------------------------------------------------------------------
# ChromaDB persistence
chroma_data/
chromadb/
*.chroma
*.parquet

# SQLite databases (if used locally)
*.sqlite
*.sqlite3
*.db

# User uploaded study materials & media cache
uploads/
media/
storage/
temp_uploads/

# ------------------------------------------------------------------------------
# Operating System & File System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*~
*.bak
# LearnMate AI local test artifacts
.env.test
.env.local
*.log
test-results/